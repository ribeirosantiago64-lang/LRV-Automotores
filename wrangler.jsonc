{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lrv-automotores",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "vars": {
    "GITHUB_OWNER": "ribeirosantiago64-lang",
    "GITHUB_REPO": "LRV-Automotores",
    "GITHUB_BRANCH": "main"
  },
  "secrets": {
    "required": ["ADMIN_PASSWORD", "SESSION_SECRET", "GITHUB_TOKEN"]
  },
  "d1_databases": [
    { "binding": "INQUIRIES_DB", "database_name": "lrv-inquiries" }
  ],
  "r2_buckets": [
    { "binding": "VEHICLE_PHOTOS", "bucket_name": "lrv-vehicle-photos" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
